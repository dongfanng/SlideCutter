{
  "name": "slidecutter",
  "version": "0.1.0",
  "private": true,
  "description": "本地 PPT 素材智能切片工具（纯前端，数据不出本机）",
  "type": "module",
  "scripts": {
    "build": "mkdir -p web/vendor && cp node_modules/jszip/dist/jszip.min.js node_modules/pptxgenjs/dist/pptxgen.min.js web/vendor/",
    "start": "npm run build && node server.js"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1"
  }
}
